# ── Core ──
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Database ──
DATABASE_URL=postgresql://coach:coach@localhost:5432/englishcoach

# ── Auth — generate with: openssl rand -hex 32 ──
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── Providers ──
SPEECH_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── AI (optional) ──
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Zoom Meeting SDK (optional) ──
# ZOOM_SDK_KEY=...
# ZOOM_SDK_SECRET=...
